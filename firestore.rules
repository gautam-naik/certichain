rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == '07naikgautam@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['user', 'admin'];
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'emailVerified', 'preferredRolePreset', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'emailVerified', 'preferredRolePreset', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.emailVerified is bool
        && data.preferredRolePreset in ['general', 'reasoning', 'interactive', 'fast'];
    }

    function isValidSavedVerification(data) {
      return data.keys().hasAll(['ownerUid', 'certificateId', 'result', 'legitimacyLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'certificateId', 'result', 'legitimacyLabel', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.certificateId is string && data.certificateId.size() >= 1 && data.certificateId.size() <= 64
        && data.result in ['AUTHENTIC', 'TAMPERED', 'REVOKED', 'NOT_FOUND']
        && data.legitimacyLabel is string && data.legitimacyLabel.size() >= 1 && data.legitimacyLabel.size() <= 160
        && (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['ownerUid', 'title', 'rolePreset', 'useSearchGrounding', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'title', 'rolePreset', 'useSearchGrounding', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.rolePreset in ['general', 'reasoning', 'interactive', 'fast']
        && data.useSearchGrounding is bool;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['ownerUid', 'sessionId', 'role', 'content', 'model', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'sessionId', 'role', 'content', 'model', 'groundingTitles', 'createdAt'])
        && isValidId(data.ownerUid)
        && isValidId(data.sessionId)
        && data.role in ['user', 'model']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 12000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
        && (!('groundingTitles' in data) || (
          data.groundingTitles is list
          && data.groundingTitles.size() <= 10
          && (data.groundingTitles.size() == 0 || (data.groundingTitles[0] is string && data.groundingTitles[0].size() <= 200))
        ));
    }

    // --- Collection Rules ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users_public/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == request.auth.uid
        && (incoming().role == 'user' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /users_private/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'emailVerified', 'preferredRolePreset', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /users/{userId}/saved_verifications/{verificationId} {
      allow get: if isValidId(userId) && isValidId(verificationId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(verificationId)
        && isOwner(userId)
        && isValidSavedVerification(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(verificationId)
        && isValidSavedVerification(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'result', 'legitimacyLabel', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isValidId(verificationId) && (isOwner(userId) || isAdmin());
    }

    match /users/{userId}/chat_sessions/{sessionId} {
      allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(sessionId)
        && isOwner(userId)
        && isValidChatSession(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(sessionId)
        && isValidChatSession(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'rolePreset', 'useSearchGrounding', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(userId)
          && isValidId(sessionId)
          && isValidId(messageId)
          && (isOwner(userId) || isAdmin())
          && get(/databases/$(database)/documents/users/$(userId)/chat_sessions/$(sessionId)).data.ownerUid == userId;
        allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidId(messageId)
          && isOwner(userId)
          && isValidChatMessage(incoming())
          && incoming().ownerUid == request.auth.uid
          && incoming().sessionId == sessionId
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId)/chat_sessions/$(sessionId))
          && getAfter(/databases/$(database)/documents/users/$(userId)/chat_sessions/$(sessionId)).data.ownerUid == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
