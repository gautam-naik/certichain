# CertiChain Environment Configuration
# Copy to .env and customize for your deployment

# Server & Security
PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="12h"

# Seeded Demo Administrator Account (used to seed initial admin in SQLite if none exists)
ADMIN_EMAIL="admin@certichain.edu"
ADMIN_PASSWORD="CertiChain@2026"
ADMIN_NAME="Dr. Elena Vance (Registrar)"

# Database
DATABASE_PATH="./certichain.db"

# Blockchain Configuration (Hardhat / Ethereum JSON-RPC)
# Leave empty or point to http://127.0.0.1:8545 when running local Hardhat node
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
# Optional: Deployed CertificateRegistry contract address (if omitted in live RPC mode, server can auto-deploy when private key is set)
CONTRACT_ADDRESS=""
# Optional: Hardhat Account #0 private key for local development ONLY (never commit real mainnet keys)
BLOCKCHAIN_PRIVATE_KEY=""
# Set to "true" to forbid demo ledger fallback in production
STRICT_BLOCKCHAIN_MODE="false"

# Python FastAPI Backend Configuration (if running /backend instead of server.ts)
BACKEND_PORT=8000
SQLALCHEMY_DATABASE_URL="sqlite:///./certichain.db"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
